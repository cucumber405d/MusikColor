<Window x:Class="MusikColor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="MusikColor" Height="720" Width="1100" Background="#0A0A12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Источник:" VerticalAlignment="Center" Foreground="White" Margin="0,0,6,0" />
            <ComboBox x:Name="SourceCombo" Width="160" SelectionChanged="SourceCombo_SelectionChanged">
                <ComboBoxItem Content="Системный звук" Tag="loopback" />
                <ComboBoxItem Content="Микрофон" Tag="microphone" />
            </ComboBox>

            <TextBlock Text="Устройство:" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="White" />
            <ComboBox x:Name="DeviceCombo" Width="280" DisplayMemberPath="FriendlyName" />

            <TextBlock Text="Визуализация:" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="White" />
            <ComboBox x:Name="PluginCombo" Width="180" DisplayMemberPath="DisplayName" SelectionChanged="PluginCombo_SelectionChanged" />

            <CheckBox x:Name="AutoCycleCheck" Content="Автосмена" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="White"
                      Checked="AutoCycleCheck_CheckedChanged" Unchecked="AutoCycleCheck_CheckedChanged" />
            <TextBlock Text="сек:" VerticalAlignment="Center" Foreground="White" Margin="6,0,4,0" />
            <TextBox x:Name="AutoCycleIntervalBox" Width="46" Text="10" VerticalAlignment="Center" TextChanged="AutoCycleIntervalBox_TextChanged" />

            <Button x:Name="StartStopButton" Content="Старт" Width="90" Margin="16,0,0,0" Click="StartStopButton_Click" />
        </StackPanel>

        <skia:SKElement x:Name="Canvas" Grid.Row="1" PaintSurface="Canvas_PaintSurface" />
    </Grid>
</Window>
